{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node scripts/copy-katex.mjs && vite build",
        "dev": "vite",
        "a11y": "node tests/a11y/axe.mjs",
        "perf": "node tests/perf/lighthouse.mjs",
        "qa:smoke": "node tests/qa/smoke.mjs",
        "qa:admin": "node tests/qa/admin-walkthrough.mjs",
        "katex": "node scripts/copy-katex.mjs",
        "world-map": "node scripts/build-world-map.mjs",
        "qa:chat": "node tests/qa/chat-fixes.mjs",
        "qa:chat-width": "node tests/qa/chat-width.mjs",
        "qa:focus": "node tests/qa/focus.mjs",
        "qa:buttons": "node tests/qa/buttons-auth.mjs",
        "qa:danger-forms": "node tests/qa/danger-forms.mjs",
        "qa:analytics": "node tests/qa/analytics.mjs",
        "qa:pages": "node tests/qa/pages-cms.mjs",
        "qa:readability": "node tests/qa/readability.mjs",
        "showcase": "npm --prefix tools/showcase install --silent --no-audit --no-fund && node tools/showcase/build.mjs",
        "showcase:capture": "npm --prefix tools/showcase install --silent --no-audit --no-fund && node tools/showcase/capture.mjs",
        "qa:arabic": "node tests/qa/arabic.mjs",
        "perf:arabic": "PERF_PAGES=/ar PERF_OUT=storage/app/lighthouse-arabic node tests/perf/lighthouse.mjs",
        "qa:appearance": "node tests/qa/appearance.mjs",
        "qa:admin-filters": "node tests/qa/admin-filters.mjs"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.1",
        "@svg-maps/world": "^2.0.0",
        "@tailwindcss/vite": "^4.0.0",
        "@tiptap/core": "^2.26.1",
        "@tiptap/extension-link": "^2.26.1",
        "@tiptap/starter-kit": "^2.26.1",
        "alpinejs": "^3.17.4",
        "chart.js": "^4.6.1",
        "concurrently": "^10.0.3",
        "fontaine": "^0.8.2",
        "katex": "^0.16.22",
        "laravel-vite-plugin": "^3.1",
        "lighthouse": "^13.0.1",
        "playwright": "^1.58.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
